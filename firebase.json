{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": "ssr",
        "region": "us-central1"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
